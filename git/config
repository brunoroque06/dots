[alias]
d = diff --word-diff=color
lp = log -p
s = status -s

[credential]
helper = osxkeychain

[core]
pager = less -R

[diff]
algorithm = histogram
colorMoved = zebra
mnemonicPrefix = true
renames = copies
tool = code

[difftool "code"]
cmd = code -d -w $LOCAL $REMOTE

[help]
autocorrect = prompt

[init]
defaultBranch = main

[merge]
conflictstyle = zdiff3
tool = code

[mergetool "code"]
cmd = code -m -w $REMOTE $LOCAL $BASE $MERGED
keepBackup = false

[push]
autoSetupRemote = true

[rerere]
enabled = true

