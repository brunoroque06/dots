[alias]
a = add
b = branch
ch = checkout
co = commit
con-edit = config --edit --global
con-list = config --list --show-origin
d = diff
f = fetch
l = log
ll = log --all --decorate --graph --format=format:'%Cblue%h %Creset- %Cgreen%ar %Creset%s %C(dim)- %an%C(auto)%d' -10
lp = log -p
pul = pull
pus = push
sh = show
st = status -s
sw = switch

[credential]
helper = osxkeychain

[core]
pager = less -R

[diff]
algorithm = histogram
colorMoved = zebra
renames = copies
tool = code

[difftool "code"]
cmd = code -d -w $LOCAL $REMOTE

[help]
autocorrect = prompt

[init]
defaultBranch = main

[merge]
conflictstyle = zdiff3
tool = code

[mergetool "code"]
cmd = code -m -w $REMOTE $LOCAL $BASE $MERGED
keepBackup = false

[push]
autoSetupRemote = true

[rerere]
enabled = true

