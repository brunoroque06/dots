[alias]
a = add
ap = add -p
b = branch
ch = checkout
co = commit
config-edit = config --edit --global
config-list = config --list --show-origin
d = diff
ds = diff --staged
f = fetch
l = log
lp = log -p
r = restore
rp = restore -p
rps = restore -p --staged
s = status -s
sw = switch

[credential]
helper = osxkeychain

[core]
pager = /opt/homebrew/opt/git/share/git-core/contrib/diff-highlight/diff-highlight | less -R

[diff]
algorithm = histogram
colorMoved = zebra
mnemonicPrefix = true
renames = copies
tool = code

[difftool "code"]
cmd = code -d -w $LOCAL $REMOTE

[help]
autocorrect = prompt

[init]
defaultBranch = main

[interactive]
diffFilter = /opt/homebrew/opt/git/share/git-core/contrib/diff-highlight/diff-highlight
singleKey = true

[merge]
conflictstyle = zdiff3
tool = code

[mergetool "code"]
cmd = code -m -w $REMOTE $LOCAL $BASE $MERGED
keepBackup = false

[push]
autoSetupRemote = true

[rerere]
enabled = true

