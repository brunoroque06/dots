[
  {
    "bindings": {
      "cmd-,": "zed::OpenSettingsFile",
      "cmd-[": "pane::GoBack",
      "cmd-]": "pane::GoForward",
      "cmd-b": "file_finder::Toggle",
      "cmd-f": "search::ToggleReplace",
      // "cmd-k": "command_palette::Toggle",
      "cmd-l": "project_panel::ToggleFocus",
      "cmd-o": "file_finder::Toggle",
      "cmd-shift-h": [
        "action::Sequence",
        ["workspace::CloseAllDocks", "workspace::ClearAllNotifications"]
      ]
    }
  },
  {
    "bindings": {
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "[ f": "vim::PreviousMethodStart",
      "] f": "vim::NextMethodStart",
      "[ g": "editor::GoToPreviousChange",
      "] g": "editor::GoToNextChange",
      "cmd-.": "editor::ToggleCodeActions",
      "cmd-shift-y": "project_symbols::Toggle",
      "cmd-y": "outline::Toggle",
      "space =": "editor::Format",
      "space b": "file_finder::Toggle",
      "g f": "editor::OpenPermalinkToLine"
    },
    "context": "Editor && vim_mode == helix_normal"
  },
  {
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
      "ctrl-x": "editor::ShowCompletions"
    },
    "context": "Editor && vim_mode == insert"
  }
]
